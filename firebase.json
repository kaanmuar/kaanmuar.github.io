{
  "functions": {
    "source": "functions",
    "ignore": ["node_modules", ".git", "*.jdk"]
  },
  "hosting": {
    "public": "desk-host",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/desk", "function": "reviewUrl" },
      { "source": "/desk/**", "function": "reviewUrl" }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
