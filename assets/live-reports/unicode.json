emove the old analytics.js tags: a request and cookies for data no one receives.","summary":"home.unicode.org scores 69 out of 100 (D). 3 checks fail now, 30 are at risk, and 14 pass. Fix first: HSTS is not sent.","score":{"overall":69,"grade":"D","areas":{"SEO":{"score":77,"grade":"C","fail":0,"risk":7,"pass":4,"person":0},"GEO":{"score":86,"grade":"B","fail":0,"risk":3,"pass":4,"person":0},"Analytics":{"score":82,"grade":"B","fail":0,"risk":2,"pass":2,"person":1},"Security":{"score":46,"grade":"F","fail":1,"risk":9,"pass":3,"person":0},"Accessibility":{"score":71,"grade":"C","fail":1,"risk":3,"pass":1,"person":1},"Performance":{"score":62,"grade":"D","fail":1,"risk":6,"pass":0,"person":0}},"totals":{"fail":3,"risk":30,"pass":14,"person":2},"severities":{"critical":0,"high":1,"medium":10,"low":22}},"fix":[{"area":"Security","verdict":"fail","severity":"medium","title":"HSTS is not sent","evidence":"strict-transport-security was absent on the start page. Missing on 16 of 20 pages read. A first visit over http can be intercepted.","fix":"Send Strict-Transport-Security: max-age=31536000; includeSubDomains.","effort":"minutes"},{"area":"Security","verdict":"risk","severity":"medium","title":"Other sites can frame the page","evidence":"Neither X-Frame-Options nor CSP frame-ancestors was sent, so the page can be framed for clickjacking. Missing on all 20 pages read.","fix":"Send Content-Security-Policy: frame-ancestors 'self' (and X-Frame-Options: SAMEORIGIN for old browsers).","effort":"minutes"},{"area":"Accessibility","verdict":"fail","severity":"medium","title":"1 form control has no label","evidence":"On /sponsors. Screen readers announce them as an unnamed field.","fix":"Pair each control with <label for>, wrap it in a label, or add aria-label.","effort":"minutes"},{"area":"Security","verdict":"risk","severity":"medium","title":"No content security policy","evidence":"content-security-policy was absent on the start page. Missing on all 20 pages read. Injected scripts are not limited by the browser.","fix":"Start with the Report-Only policy in the fix kit, watch the reports for a week, then enforce it.","effort":"hours"},{"area":"Security","verdict":"risk","severity":"medium","title":"Security headers on the start page are missing on other pages","evidence":"X-Content-Type-Options on 4 pages, Referrer-Policy on 4 pages, out of 20 pages read. Attackers pick the weakest page.","fix":"Set the headers once at the server, CDN, or host config so every response carries them.","effort":"minutes"},{"area":"Security","verdict":"risk","severity":"low","title":"Permissions-Policy is not sent","evidence":"Embedded content can ask for the camera, microphone, or location. Missing on all 20 pages read.","fix":"Send Permissions-Policy: camera=(), microphone=(), geolocation=().","effort":"minutes"}],"works":[{"area":"SEO","title":"Every internal link that was opened answered"},{"area":"GEO","title":"AI answer and search crawlers may read the start page"},{"area":"Analytics","title":"2 measurement tools were found"},{"area":"Security","title":"Plain http redirects permanently to https"},{"area":"Accessibility","title":"The start page declares its language"},{"area":"SEO","title":"Every page has a title"},{"area":"SEO","title":"Unknown paths answer 404"},{"area":"SEO","title":"The start page sets a mobile viewport"}],"geo":{"answersAllowed":9,"answersBlocked":[],"trainingBlocked":[],"llms":false,"jsOnly":false,"words":918,"schema":[]},"security":[{"label":"HTTPS redirect","state":"pass"},{"label":"HSTS","state":"fail"},{"label":"Content-Security-Policy","state":"risk"},{"label":"Frame protection","state":"risk"},{"label":"X-Content-Type-Options","state":"pass"},{"label":"Referrer-Policy","state":"pass"},{"label":"Permissions-Policy","state":"risk"},{"label":"TLS certificate","state":"pass"},{"label":"security.txt","state":"risk"},{"label":"SPF","state":"pass"},{"label":"DMARC","state":"risk"},{"label":"CAA","state":"risk"}],"speed":{"lighthouse":