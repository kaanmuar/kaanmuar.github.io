# Stripe, Wompi, and Mercado Pago accept sandbox keys only. PayPal live mode is PAYPAL_MODE=live. Do not commit functions/.env.
# Web search for mentions and owner addresses: Brave Search API first (https://api-dashboard.search.brave.com, free plan),
# Tavily (https://app.tavily.com, free plan) when Brave has no key, fails or finds nothing. Without either, the web search is off.
BRAVE_SEARCH_KEY=
# Shared secret sent as x-review-key to the reviewBrowser function. Without it, reviews skip the headless browser and mail no PDF.
BROWSER_KEY=
# reviewBrowser endpoint. Empty uses the deployed europe-west1 function.
BROWSER_URL=
# Local Chrome or Chromium binary for reviewBrowser when run outside Cloud Functions. Empty uses the bundled Chromium.
CHROME_PATH=
# Google API key with the Chrome UX Report API allowed. Without it, PAGESPEED_KEY is tried; without either, reviews leave out the six-month Core Web Vitals trend.
CRUX_KEY=
# Account that signs in to the operator desk, by password or emailed link. Empty uses kaanmuar@gmail.com.
DESK_GOOGLE_EMAIL=
# Comma-separated addresses that run reviews without payment, alongside the desk's Free runs list.
FREE_RUN_EMAILS=
# Gemini API key (https://aistudio.google.com/apikey). Ask the report's AI phrasing toggle shows only when it is set.
GEMINI_API_KEY=
# Gemini model for that phrasing. Empty uses gemini-flash-latest.
GEMINI_MODEL=
# Classic token with public_repo and project scopes. The daily job opens one bug per new failed-review cause class.
GITHUB_BUGS_TOKEN=
MERCADOPAGO_ACCESS_TOKEN=
# 1 turns on the scheduled notices to site owners whose site is on Live Reports.
OWNER_NOTICES_LIVE=
# ownerReplies endpoint used in owner notice links. Empty uses the deployed us-central1 function.
OWNER_REPLIES_URL=
# Subdomain whose MX points at SendGrid Inbound Parse, so owners reply to reply+<token>@<domain>. Empty sends replies to the alert inbox.
OWNER_REPLY_DOMAIN=
# Long random string. SendGrid Inbound Parse posts to /inbound?key=<this>; any other key gets 403.
OWNER_REPLY_KEY=
# Google PageSpeed Insights API key. Without it, reviews leave out the lab speed scores.
PAGESPEED_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# PayPal sandbox app used only for runs that carry a valid QA_TEST_KEY.
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
# Webhook ids PayPal gives when reviewUrl/paypal-webhook/live and /sandbox are registered; events are verified against them.
PAYPAL_WEBHOOK_ID=
PAYPAL_SANDBOX_WEBHOOK_ID=
# Long random string. The publishable-reports endpoint answers only requests with x-publish-key set to it.
PUBLISH_KEY=
# Long random string. A checkout that sends it as testKey pays through the PayPal sandbox.
QA_TEST_KEY=
# reviewUrl endpoint the scheduled jobs call. Empty uses the deployed us-central1 function.
REVIEW_FN_URL=
# 1 turns the scheduled return notes on. Leave it empty until the report mail is seen landing in inboxes.
REVIEW_NOTES_LIVE=
# Server-side sign-in apps. Each one's redirect URI is https://carlosandmunoz.com/qa-review.html (and http://127.0.0.1:8765/qa-review.html for the local server).
# A provider is offered only when both its id and secret are set and it is listed in REVIEW_SIGN_IN_PROVIDERS.
REVIEW_OAUTH_DISCORD_ID=
REVIEW_OAUTH_DISCORD_SECRET=
REVIEW_OAUTH_GITLAB_ID=
REVIEW_OAUTH_GITLAB_SECRET=
REVIEW_OAUTH_LINKEDIN_ID=
REVIEW_OAUTH_LINKEDIN_SECRET=
REVIEW_OAUTH_SLACK_ID=
REVIEW_OAUTH_SLACK_SECRET=
REVIEW_OAUTH_TWITCH_ID=
REVIEW_OAUTH_TWITCH_SECRET=
# Sign-in options on the review page besides email. The *.com ones need their provider turned on in Firebase Auth first.
REVIEW_SIGN_IN_PROVIDERS=google.com,github.com,microsoft.com,yahoo.com,facebook.com,twitter.com,linkedin,gitlab,discord,twitch,slack
# Long random string (openssl rand -hex 32). Site owners' qa-lab-verify tokens are an HMAC of it, so changing it voids every token.
# Without it, site verification by DNS record or homepage tag is off.
REVIEW_VERIFY_KEY=
# SendGrid API key with Mail Send. Without it, no report, receipt or notice mail goes out.
SENDGRID_API_KEY=
SENDGRID_FROM=verified-sender@yourdomain.com
STRIPE_SECRET_KEY=
# 1 turns on the nightly country sweep that reviews one listed site per tick.
SWEEP_LIVE=
# Tavily search API key, the web search fallback after BRAVE_SEARCH_KEY.
TAVILY_API_KEY=
# Google Cloud API key restricted to the Web Risk API. It checks the reviewed site against Google's Safe Browsing lists.
WEBRISK_KEY=
WOMPI_PRIVATE_KEY=
