# Stripe, Wompi, and Mercado Pago accept sandbox keys only. PayPal live mode is PAYPAL_MODE=live. Do not commit functions/.env.
#
# Keys, tokens and shared secrets are Secret Manager secrets, not lines in this file. functions/secrets.js binds each to the
# functions that read it. Set each once with `firebase functions:secrets:set NAME`, then delete the name from functions/.env:
# Firebase refuses to deploy a name that is both a secret and an env var. For the local review server, put them in
# functions/.secret.local in the same NAME=value form (gitignored).
#   BRAVE_SEARCH_KEY            Brave Search API (https://api-dashboard.search.brave.com, free plan) for mentions and owner
#                               addresses. Tavily (TAVILY_API_KEY below) is the fallback; without either, the web search is off.
#   BROWSER_KEY                 Shared secret sent as x-review-key to reviewBrowser. Without it, reviews skip the headless browser and mail no PDF.
#   CLOUDFLARE_ANALYTICS_TOKEN  Cloudflare token with Zone Analytics Read for Jarvis. Without it, CLOUDFLARE_API_TOKEN is used.
#   CLOUDFLARE_API_TOKEN        Cloudflare API token for the Jarvis traffic numbers.
#   CRUX_KEY                    Google API key with the Chrome UX Report API allowed. Without it, PAGESPEED_KEY is tried; without
#                               either, reviews leave out the six-month Core Web Vitals trend.
#   GEMINI_API_KEY              Gemini API key (https://aistudio.google.com/apikey). Ask the report's AI phrasing toggle shows only when it is set.
#   GITHUB_APP_PRIVATE_KEY      The qa-lab-agents app's PEM, base64 on one line (scripts/functions-github-app-env.js). Mints the GitHub tokens.
#   GITHUB_BUGS_TOKEN           Fallback classic token with repo, workflow and project scopes, used while the app key is unset or not installed.
#   INSTANTLY_API_KEY           Instantly API key (Settings > Integrations > API keys) for the Jarvis outreach numbers.
#   OWNER_REPLY_KEY             Long random string. SendGrid Inbound Parse posts to /inbound?key=<this>; any other key gets 403.
#   PAGESPEED_KEY               Google PageSpeed Insights API key. Without it, reviews leave out the lab speed scores.
#   PAYPAL_CLIENT_SECRET        PayPal app secret for PAYPAL_CLIENT_ID.
#   PAYPAL_SANDBOX_CLIENT_SECRET  PayPal sandbox app secret for PAYPAL_SANDBOX_CLIENT_ID.
#   PUBLISH_KEY                 Long random string. The publishable-reports endpoint answers only requests with x-publish-key set to it.
#   QA_TEST_KEY                 Long random string. A checkout that sends it as testKey pays through the PayPal sandbox.
#   REVIEW_VERIFY_KEY           Long random string (openssl rand -hex 32). Site owners' qa-lab-verify tokens are an HMAC of it, so
#                               changing it voids every token. Without it, site verification by DNS record or homepage tag is off.
#   SENDGRID_API_KEY            SendGrid API key with Mail Send. Without it, no report, receipt or notice mail goes out.
#   STRIPE_SECRET_KEY           Stripe secret key.
#   WEBRISK_KEY                 Google Cloud API key restricted to the Web Risk API. It checks the reviewed site against Google's Safe Browsing lists.
#   YOUTUBE_KEY                 API key limited to the YouTube Data API v3, for the Jarvis social numbers.
# The secrets still listed below are unset today. Setting one means moving it to Secret Manager and adding it to functions/secrets.js.
#
# reviewBrowser endpoint. Empty uses the deployed europe-west1 function.
BROWSER_URL=
# Local Chrome or Chromium binary for reviewBrowser when run outside Cloud Functions. Empty uses the bundled Chromium.
CHROME_PATH=
# Cloudflare zone the Jarvis traffic numbers read.
CLOUDFLARE_ZONE_ID=
# Account that signs in to the operator desk, by password or emailed link. Empty uses kaanmuar@gmail.com.
DESK_GOOGLE_EMAIL=
# Comma-separated addresses that run reviews without payment, alongside the desk's Free runs list.
FREE_RUN_EMAILS=
# Gemini model for the report's AI phrasing. Empty uses gemini-flash-latest.
GEMINI_MODEL=
# The qa-lab-agents GitHub App mints the functions' GitHub tokens (functions/github-app.js). Run
# scripts/functions-github-app-env.js for the app ID; GITHUB_APP_PRIVATE_KEY (the PEM, base64 on one line) and the
# fallback GITHUB_BUGS_TOKEN (repo, workflow and project scopes) are Secret Manager secrets.
GITHUB_APP_ID=
# Secret, unset today.
MERCADOPAGO_ACCESS_TOKEN=
# 1 turns on the scheduled notices to site owners whose site is on Live Reports.
OWNER_NOTICES_LIVE=
# ownerReplies endpoint used in owner notice links. Empty uses the deployed us-central1 function.
OWNER_REPLIES_URL=
# Subdomain whose MX points at SendGrid Inbound Parse, so owners reply to reply+<token>@<domain>. Empty sends replies to the alert inbox.
OWNER_REPLY_DOMAIN=
PAYPAL_CLIENT_ID=
PAYPAL_MODE=sandbox
# PayPal sandbox app used only for runs that carry a valid QA_TEST_KEY.
PAYPAL_SANDBOX_CLIENT_ID=
# Webhook ids PayPal gives when reviewUrl/paypal-webhook/live and /sandbox are registered; events are verified against them.
PAYPAL_SANDBOX_WEBHOOK_ID=
PAYPAL_WEBHOOK_ID=
# reviewUrl endpoint the scheduled jobs call. Empty uses the deployed us-central1 function.
REVIEW_FN_URL=
# 1 turns the scheduled return notes on. Leave it empty until the report mail is seen landing in inboxes.
REVIEW_NOTES_LIVE=
# Server-side sign-in apps. Each one's redirect URI is https://carlosandmunoz.com/qa-review.html (and http://127.0.0.1:8765/qa-review.html for the local server).
# A provider is offered only when both its id and secret are set and it is listed in REVIEW_SIGN_IN_PROVIDERS. The *_SECRET values are secrets, unset today.
REVIEW_OAUTH_DISCORD_ID=
REVIEW_OAUTH_DISCORD_SECRET=
REVIEW_OAUTH_GITLAB_ID=
REVIEW_OAUTH_GITLAB_SECRET=
REVIEW_OAUTH_LINKEDIN_ID=
REVIEW_OAUTH_LINKEDIN_SECRET=
REVIEW_OAUTH_SLACK_ID=
REVIEW_OAUTH_SLACK_SECRET=
REVIEW_OAUTH_TWITCH_ID=
REVIEW_OAUTH_TWITCH_SECRET=
# Sign-in options on the review page besides email. The *.com ones need their provider turned on in Firebase Auth first.
REVIEW_SIGN_IN_PROVIDERS=google.com,github.com,microsoft.com,yahoo.com,facebook.com,twitter.com,linkedin,gitlab,discord,twitch,slack
SENDGRID_FROM=verified-sender@yourdomain.com
# 1 turns on the nightly country sweep that reviews one listed site per tick.
SWEEP_LIVE=
# Tavily search API key (https://app.tavily.com, free plan), the web search fallback after BRAVE_SEARCH_KEY. Secret, unset today.
TAVILY_API_KEY=
# Secret, unset today.
WOMPI_PRIVATE_KEY=
