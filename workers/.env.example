# Cloudflare Workers env for preflight, outreach-cron, and uptime-check (#3838 / #4031 / #4032).
# Names only — never commit real secret values. Unset = feature off (soft-fail).
# Copy to workers/.env locally if useful; it is not loaded by deploy unless you export the vars.
#
# --- preflight deploy (workers/preflight/cloudflare.config.ts) ---
# PREFLIGHT_TOKEN   Bearer token for /triage /index /delete /complete (uploaded as secret_text TOKEN)
# GEOIP_BUCKET      R2 bucket name. When set, deploy adds binding name GEOIP (workers/shared/geoip.js).
#                   Leave empty for local without R2. Upload DBs: node scripts/geoip-fetch.js --bucket <name>
#                   Daily refresh: .github/workflows/geoip-refresh.yml (needs repo var GEOIP_BUCKET + CF secrets)
# --- Worker secrets (set after deploy via cf/dashboard; not uploaded from cloudflare.config) ---
# HEARTBEAT_OUTREACH_URL / HEARTBEAT_OUTREACH_FAIL_URL  outreach-cron dead-man (healthchecks ping URL)
# HEARTBEAT_UPTIME_URL / HEARTBEAT_UPTIME_FAIL_URL      uptime-check dead-man
# UPTIME_ENDPOINTS                                      optional JSON array of URL strings or { url, expected?, timeoutMs? }
# See workers/shared/heartbeat.js and workers/uptime-check/src/index.js headers.
GEOIP_BUCKET=
HEARTBEAT_OUTREACH_FAIL_URL=
HEARTBEAT_OUTREACH_URL=
HEARTBEAT_UPTIME_FAIL_URL=
HEARTBEAT_UPTIME_URL=
PREFLIGHT_TOKEN=
UPTIME_ENDPOINTS=
