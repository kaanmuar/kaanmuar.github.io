rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'kaanmuar@gmail.com';
    }

    function only(keys) {
      return request.resource.data.keys().hasOnly(keys);
    }

    function text(field, minLen, maxLen) {
      return request.resource.data[field] is string
        && request.resource.data[field].size() >= minLen
        && request.resource.data[field].size() <= maxLen;
    }

    match /messages/{id} {
      allow get, list: if isOwner();
      // Visitors post through submitGuardedForm, which checks Turnstile and writes with the Admin SDK.
      allow create: if false;
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'rejectedAt', 'restoredAt', 'response', 'respondedAt', 'isPublicResponse'
        ]);
      allow delete: if false;
    }

    match /ratings/{id} {
      allow get, list: if isOwner();
      // Visitors post through submitGuardedForm, which checks Turnstile and writes with the Admin SDK.
      allow create: if false;
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'isAnonymous', 'response', 'respondedAt', 'isPublicResponse'
        ]);
      allow delete: if false;
    }

    match /testimonials/{id} {
      allow get, list: if true;
      allow create, update, delete: if isOwner();
    }

    match /visits/{id} {
      allow get, list, update, delete: if false;
      allow create: if only(['source', 'lang', 'referrerHost', 'createdAt'])
        && request.resource.data.source == 'cv'
        && request.resource.data.lang is string
        && request.resource.data.lang.size() <= 12
        && request.resource.data.referrerHost is string
        && request.resource.data.referrerHost.size() <= 80
        && request.resource.data.createdAt == request.time;
    }

    match /site_events/{id} {
      allow get, list: if isOwner();
      allow update, delete: if false;
      allow create: if only(['site', 'kind', 'name', 'label', 'lang', 'referrerHost', 'query', 'screen', 'page', 'title', 'timezone', 'languages', 'createdAt'])
        && request.resource.data.site in ['cv', 'studio', 'lab', 'review']
        && (
          (request.resource.data.kind == 'visit' && request.resource.data.name in ['visit', 'sim_loaded'])
          || (request.resource.data.kind == 'export' && request.resource.data.name in ['export_cv', 'print_cv', 'lab_report', 'studio_report'])
          || (request.resource.data.kind == 'run' && request.resource.data.name in ['lab_run', 'qa_review_start', 'qa_review_done'])
          || (request.resource.data.kind == 'view' && request.resource.data.name in ['hub_view', 'post_view'])
          || (request.resource.data.kind == 'click' && request.resource.data.name in [
            'share_cv', 'open_simulator', 'open_qa_lab', 'open_contact_widget',
            'submit_message', 'submit_rating', 'sim_run_sprint', 'sim_sprint_complete',
            'site_tour_start', 'open_clip', 'company_site',
            'qa_review_stop', 'qa_review_share', 'qa_review_pay_open', 'qa_review_pay_view',
            'qa_review_checkout', 'qa_review_pay_result', 'qa_review_legal_country',
            'qa_review_blocked', 'qa_review_terms', 'qa_review_follow_up', 'qa_review_reason',
            'qa_review_frameworks', 'qa_review_scope', 'qa_review_tools', 'qa_review_print',
            'qa_review_news', 'qa_review_alerts', 'qa_review_credentials', 'qa_review_cases',
            'qa_review_language_change', 'qa_review_account_enter', 'qa_review_account_stop',
            'qa_review_sign_in', 'qa_review_sign_in_failed', 'qa_review_sign_in_needed', 'qa_review_deal_shown',
            'qa_review_live_open', 'qa_review_live_filter', 'qa_review_live_nav', 'open_url_review',
            'hub_open', 'hub_play', 'hub_copy', 'hub_share', 'hub_download', 'hub_report',
            'post_play', 'post_copy', 'post_share', 'post_download', 'post_report', 'post_related'
          ])
        )
        && request.resource.data.label is string
        && request.resource.data.label.size() <= 80
        && request.resource.data.lang is string
        && request.resource.data.lang.size() <= 12
        && request.resource.data.referrerHost is string
        && request.resource.data.referrerHost.size() <= 80
        && (!('query' in request.resource.data) || request.resource.data.query.matches('^[A-Za-z0-9=&%_.?+\\-]{0,120}$'))
        && (!('screen' in request.resource.data) || request.resource.data.screen in ['phone', 'desktop'])
        && (!('page' in request.resource.data) || (request.resource.data.page is string && request.resource.data.page.size() <= 80))
        && (!('title' in request.resource.data) || (request.resource.data.title is string && request.resource.data.title.size() <= 120))
        && (!('timezone' in request.resource.data) || (request.resource.data.timezone is string && request.resource.data.timezone.size() <= 60))
        && (!('languages' in request.resource.data) || (request.resource.data.languages is string && request.resource.data.languages.size() <= 80))
        && request.resource.data.createdAt == request.time;
    }

    match /site_reports/{id} {
      allow get, list: if isOwner();
      allow create, update, delete: if false;
    }

    match /blocked_senders/{emailId} {
      allow get, list: if isOwner();
      allow create, update: if isOwner()
        && request.resource.data.keys().hasOnly(['blockedAt'])
        && request.resource.data.blockedAt == request.time;
      allow delete: if isOwner();
    }

    match /cvContent/{id} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isOwner() && id == 'live';
    }

    // Written by refreshSocialHubStats (functions/social-hub-stats.js) for the Social hub pane.
    match /socialHubStats/{id} {
      allow get, list: if isOwner();
      allow write: if false;
    }

    // Read by scripts/build-social-hub.js without credentials; everything in it goes on the public hub.
    match /socialHub/{id} {
      allow get: if true;
      allow list, delete: if false;
      allow create, update: if isOwner() && id == 'live'
        && only(['json', 'updatedAt'])
        && text('json', 2, 500000)
        && request.resource.data.updatedAt == request.time;
    }

    match /cvPhotos/{id} {
      allow get, list: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['url', 'createdAt'])
        && request.resource.data.url is string
        && request.resource.data.url.size() < 500
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /abuse/{id} {
      allow read, write: if false;
    }

    match /url_reviews/{id} {
      allow get, list: if isOwner();
      allow create, update, delete: if false;
    }

    match /url_review_alerts/{id} {
      allow get, list: if isOwner();
      allow create, update, delete: if false;
    }

    match /url_review_opens/{id} {
      allow get, list: if isOwner();
      allow create, update, delete: if false;
    }

    match /url_review_reports/{id} {
      allow get, list: if isOwner();
      allow create, update, delete: if false;
    }

    match /url_review_free_runs/{emailId} {
      allow get, list: if isOwner();
      allow create, update, delete: if false;
    }

    match /mail/{id} {
      allow read, write: if false;
    }

    match /notification_state/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
