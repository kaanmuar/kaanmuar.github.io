{
  "version": 1,
  "hooks": {
    "sessionStart": [{ "command": "node .cursor/hooks/preflight.js session", "timeout": 5 }],
    "beforeSubmitPrompt": [{ "command": "node .cursor/hooks/preflight.js prompt", "timeout": 20 }],
    "postToolUse": [{ "command": "node .cursor/hooks/preflight.js tool", "timeout": 3 }],
    "stop": [{ "command": "node .cursor/hooks/preflight.js stop", "timeout": 5 }]
  }
}
