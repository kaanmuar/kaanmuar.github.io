{
  "name": "kaanmuar.github.io",
  "version": "1.0.0",
  "description": "Interactive CV for Carlos A. Muñoz",
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./input.css -o ./style.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./input.css -o ./style.css --watch",
    "test": "npm run test:review && npm run test:playwright && npm run test:cypress",
    "test:review": "node --disable-warning=ExperimentalWarning --test tests/unit/url-review.test.js tests/unit/site-glossary.test.js",
    "test:full": "npm run test:playwright && npm run test:cypress && npm run test:robot",
    "test:cy": "cypress run",
    "test:cypress": "cypress run",
    "test:robot": "python3 -m venv .venv-robot >/dev/null 2>&1; .venv-robot/bin/pip install -q -r requirements-robot.txt && .venv-robot/bin/robot --outputdir robot-results tests/robot",
    "test:playwright": "playwright test",
    "test:selenium": "mocha \"selenium/**/*.spec.js\" --timeout 120000 --exit --reporter spec",
    "test:wdio": "wdio run wdio/wdio.conf.js",
    "test:appium": "node scripts/run-appium.js",
    "test:codeceptjs": "codeceptjs run --config codeceptjs/codecept.conf.js --steps",
    "test:selenide": "node scripts/run-java-suite.js Selenide",
    "test:testng": "node scripts/run-java-suite.js TestNG",
    "test:watir": "node scripts/run-watir.js",
    "test:cucumber": "cucumber-js cucumber/features/catalog.feature --require cucumber/steps/catalog.steps.js",
    "test:behave": "node scripts/run-behave.js",
    "test:reqnroll": "node scripts/run-reqnroll.js",
    "test:jest": "jest --config jest/jest.config.js --runInBand",
    "test:vitest": "vitest run --config vitest/vitest.config.mjs",
    "test:mocha": "mocha mocha/catalog.spec.js --timeout 120000 --exit",
    "test:maestro": "node scripts/run-maestro.js",
    "build:catalog-suites": "node scripts/build-catalog-suites.js",
    "test:k6": "node scripts/run-k6.js",
    "test:jmeter": "node scripts/run-jmeter.js",
    "test:gatling": "node scripts/run-gatling.js",
    "lab:runners": "node scripts/native-runner.js",
    "review:server": "node scripts/url-review-server.js",
    "review:snapshot": "node scripts/review-snapshot.js",
    "review:sample": "node scripts/review-snapshot.js --sample https://carlosandmunoz.com/"
  },
  "author": "Carlos A. Muñoz",
  "license": "ISC",
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@cypress/grep": "^4.1.0",
    "@cypress/webpack-preprocessor": "^6.0.4",
    "@playwright/test": "^1.54.2",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^24.2.1",
    "@wdio/appium-service": "^9.32.0",
    "@wdio/cli": "^9.32.0",
    "@wdio/junit-reporter": "^9.32.0",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "appium": "^2.19.0",
    "appium-chromium-driver": "^1.5.1",
    "axe-core": "^4.10.3",
    "codeceptjs": "^4.2.1",
    "cypress": "^14.5.1",
    "cypress-axe": "^1.6.0",
    "cypress-mochawesome-reporter": "^3.8.4",
    "jest": "^30.5.2",
    "mocha": "^11.7.1",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.4.1",
    "mochawesome-report-generator": "^6.2.0",
    "playwright": "^1.63.0",
    "selenium-webdriver": "^4.49.0",
    "tailwindcss": "^4.3.3",
    "vitest": "^5.0.5"
  }
}
