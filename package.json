{
  "name": "kaanmuar.github.io",
  "version": "1.0.0",
  "description": "Interactive CV for Carlos A. Muñoz",
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./input.css -o ./style.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./input.css -o ./style.css --watch",
    "test": "npm run test:playwright && npm run test:cypress",
    "test:full": "npm run test:playwright && npm run test:cypress && npm run test:robot",
    "test:cy": "cypress run",
    "test:cypress": "cypress run",
    "test:robot": "python3 -m venv .venv-robot >/dev/null 2>&1; .venv-robot/bin/pip install -q -r requirements-robot.txt && .venv-robot/bin/robot --outputdir robot-results tests/robot",
    "test:playwright": "playwright test",
    "test:selenium": "mocha \"selenium/**/*.spec.js\" --timeout 120000 --exit --reporter spec",
    "test:wdio": "wdio run wdio/wdio.conf.js",
    "test:appium": "node scripts/run-appium.js",
    "lab:runners": "node scripts/native-runner.js"
  },
  "author": "Carlos A. Muñoz",
  "license": "ISC",
  "devDependencies": {
    "@cypress/grep": "^4.1.0",
    "@cypress/webpack-preprocessor": "^6.0.4",
    "@playwright/test": "^1.54.2",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^24.2.1",
    "@wdio/appium-service": "^9.32.0",
    "@wdio/cli": "^9.32.0",
    "@wdio/junit-reporter": "^9.32.0",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "appium": "^2.19.0",
    "appium-chromium-driver": "^1.5.1",
    "axe-core": "^4.10.3",
    "cypress": "^14.5.1",
    "cypress-axe": "^1.6.0",
    "cypress-mochawesome-reporter": "^3.8.4",
    "mocha": "^11.7.1",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.4.1",
    "mochawesome-report-generator": "^6.2.0",
    "selenium-webdriver": "^4.49.0",
    "tailwindcss": "^4.3.3"
  }
}
