{
	"$schema": "https://biomejs.dev/schemas/2.3.4/schema.json",
	"assist": { "enabled": false },
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 120
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "always",
			"trailingCommas": "es5"
		}
	},
	"json": {
		"formatter": {
			"trailingCommas": "none"
		}
	},
	"linter": {
		"enabled": false
	},
	"files": {
		"includes": ["**/*.js", "**/*.mjs", "**/*.cjs", "**/*.ts", "**/*.tsx", "**/*.jsx", "**/*.json"],
		"ignoreUnknown": true
	},
	"overrides": [
		{
			"includes": [
				"media/**",
				"social/**",
				"assets/**",
				"data/**",
				"android/**",
				"node_modules/**",
				".worktrees/**",
				"coverage/**",
				"playwright-report/**",
				"test-results/**",
				"package-lock.json",
				"**/captions*.json",
				"**/fixtures/**"
			],
			"formatter": { "enabled": false }
		}
	]
}
